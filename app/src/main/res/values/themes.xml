<resources>
    <!-- Bouton rempli : fond noir, texte blanc -->
    <style name="Widget.Awabi.Button" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/black</item>
        <item name="android:textColor">@color/white</item>
        <item name="rippleColor">@color/teal_200</item>
    </style>

    <!-- Bouton outline : contour noir, texte noir, fond transparent -->
    <style name="Widget.Awabi.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/black</item>
        <item name="android:textColor">@color/black</item>
        <item name="rippleColor">@color/teal_200</item>
    </style>

    <!-- Bouton texte : texte noir -->
    <style name="Widget.Awabi.Button.Text" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/black</item>
        <item name="rippleColor">@color/teal_200</item>
    </style>

    <!-- Thème principal Awabi — noir mat, accent teal -->
    <style name="Theme.Awabi" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/black</item>
        <item name="colorPrimaryVariant">@color/dark_surface</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <!-- Styles boutons par défaut pour toutes les activités -->
        <item name="materialButtonStyle">@style/Widget.Awabi.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.Awabi.Button.Outlined</item>
        <item name="borderlessButtonStyle">@style/Widget.Awabi.Button.Text</item>
    </style>

    <!--
        Thème dédié à l'overlay flottant.
        Toujours en mode clair pour garantir la lisibilité quel que soit
        le thème système (dark/light).
    -->
    <style name="Theme.Awabi.Overlay" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/black</item>
        <item name="colorPrimaryVariant">@color/dark_surface</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/black</item>
    </style>
</resources>
