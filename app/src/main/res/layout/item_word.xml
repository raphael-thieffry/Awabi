<?xml version="1.0" encoding="utf-8"?>
<!--
    Chip horizontal pour un mot japonais.
    Tap court : cycle kanji → lecture → définition (incrémente clickCount).
    Appui long : ajout au deck courant + coche verte temporaire.
    Badge discret en coin supérieur droit : nb de taps (caché si 0).
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="56dp"
    android:layout_marginEnd="6dp"
    app:cardBackgroundColor="#1A1A1A"
    app:cardCornerRadius="10dp"
    app:cardElevation="2dp"
    app:strokeColor="#333333"
    app:strokeWidth="1dp">

    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent">

        <!-- État 0 : Kanji + badge JLPT -->
        <LinearLayout
            android:id="@+id/layoutKanji"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp">

            <TextView
                android:id="@+id/tvKanji"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvJlpt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="#FF6200EE"
                android:paddingBottom="2dp"
                android:paddingEnd="5dp"
                android:paddingStart="5dp"
                android:paddingTop="2dp"
                android:textColor="#FFFFFF"
                android:textSize="8sp"
                android:textStyle="bold"
                android:visibility="gone" />

        </LinearLayout>

        <!-- État 1 : Prononciation -->
        <LinearLayout
            android:id="@+id/layoutReading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="読み方"
                android:textColor="#888888"
                android:textSize="7sp" />

            <TextView
                android:id="@+id/tvReading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="#BB86FC"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- État 2 : Définition -->
        <LinearLayout
            android:id="@+id/layoutDefinition"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="10dp"
            android:paddingVertical="8dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvDefinition"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="2"
                android:maxWidth="180dp"
                android:textColor="#E0E0E0"
                android:textSize="10sp" />

        </LinearLayout>

        <!-- Badge click count — coin supérieur droit, caché si 0 -->
        <TextView
            android:id="@+id/tvClickBadge"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="3dp"
            android:layout_marginEnd="3dp"
            android:background="@drawable/bg_badge"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:textSize="8sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Overlay coche verte — appui long → ajout deck -->
        <FrameLayout
            android:id="@+id/overlayAdded"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#CC1DB954"
            android:gravity="center"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="✓"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

        </FrameLayout>

    </FrameLayout>

</com.google.android.material.card.MaterialCardView>
