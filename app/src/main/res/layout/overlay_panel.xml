<?xml version="1.0" encoding="utf-8"?>
<!--
    Panneau horizontal semi-transparent affiché quand l'utilisateur tape sur la bulle.
    - Barre de contrôles en haut : ⚙ Gérer + 🔍 Analyser
    - Liste horizontale des mots
    - Section analyse grammaticale LLM (dépliable)
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#CC000000"
    android:orientation="vertical"
    android:paddingTop="4dp"
    android:paddingBottom="6dp">

    <!-- Barre de contrôles -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingBottom="2dp">

        <!-- Bouton ouvrir MainActivity -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOpenMain"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:padding="0dp"
            android:paddingEnd="8dp"
            android:text="⚙ Gérer"
            android:textColor="#AAFFFFFF"
            android:textSize="10sp" />

        <!-- Spacer -->
        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Bouton analyser la grammaire -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAnalyze"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:padding="0dp"
            android:paddingStart="8dp"
            android:text="✦ Analyser"
            android:textColor="#AAFFFFFF"
            android:textSize="10sp" />

        <!-- Compteur deck courant -->
        <TextView
            android:id="@+id/tvDeckCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:textColor="#88FFFFFF"
            android:textSize="10sp"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Spinner de chargement mots -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:visibility="gone" />

    <!-- Liste horizontale des mots -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvWords"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:visibility="gone" />

    <!-- Affiché quand aucun mot n'est détecté -->
    <TextView
        android:id="@+id/tvEmpty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:text="Aucun mot japonais détecté"
        android:textColor="#AAFFFFFF"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- ─── Section analyse grammaticale LLM ─── -->
    <LinearLayout
        android:id="@+id/layoutGrammar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="10dp"
        android:paddingTop="6dp"
        android:paddingBottom="4dp"
        android:visibility="gone">

        <!-- Séparateur -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#33FFFFFF"
            android:layout_marginBottom="8dp" />

        <!-- Spinner analyse en cours -->
        <ProgressBar
            android:id="@+id/progressGrammar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:visibility="gone" />

        <!-- Phrase principale — gras, légèrement plus grande -->
        <TextView
            android:id="@+id/tvMainSentence"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:lineSpacingMultiplier="1.3"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Analyse grammaticale — markdown rendu -->
        <ScrollView
            android:id="@+id/scrollGrammar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvGrammar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingMultiplier="1.4"
                android:textColor="#EEFFFFFF"
                android:textSize="11sp" />

        </ScrollView>

        <!-- Traduction FR de la phrase principale -->
        <TextView
            android:id="@+id/tvTranslation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="4dp"
            android:lineSpacingMultiplier="1.3"
            android:textColor="#CCFFFFFF"
            android:textSize="11sp"
            android:fontFamily="sans-serif-light"
            android:visibility="gone" />

        <!-- Toggle texte corrigé (caché par défaut) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnToggleCorrected"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="▶ Texte corrigé OCR"
            android:textColor="#66FFFFFF"
            android:textSize="9sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvCorrected"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:lineSpacingMultiplier="1.3"
            android:textColor="#AAFFFFFF"
            android:textSize="10sp"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Bouton debug — visible uniquement si BuildConfig.DEBUG (géré en code) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDebug"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="🐛 Debug"
        android:textColor="#AAFFFFFF"
        android:textSize="10sp"
        android:visibility="gone" />

    <!-- Vue de debug -->
    <ScrollView
        android:id="@+id/scrollDebug"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvDebug"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#111111"
            android:fontFamily="monospace"
            android:padding="8dp"
            android:textColor="#00FF88"
            android:textSize="9sp" />

    </ScrollView>

</LinearLayout>
