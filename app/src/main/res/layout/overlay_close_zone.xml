<?xml version="1.0" encoding="utf-8"?>
<!--
    Zone de fermeture affichée en bas de l'écran pendant le drag de la bulle.
    Drag la bulle dessus puis relâche pour stopper le service.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:background="#CC000000">

    <LinearLayout
        android:id="@+id/closeTarget"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_close_zone_target"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvCloseIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✕"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

    </LinearLayout>

</FrameLayout>
