<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Overlay flottant -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Service en avant-plan persistent -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Capture écran (MediaProjection) — demandée au runtime -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <!-- Réseau (Jisho, MyMemory) -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Notification (requis API 33+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Vibration haptique (appui long → ajout deck) -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".LinguaBubbleApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.LinguaBubble">

        <!-- Activité principale : setup + permissions -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Service bulle flottante -->
        <service
            android:name=".feature.bubble.FloatingBubbleService"
            android:exported="false"
            android:foregroundServiceType="specialUse|mediaProjection">
            <!-- Requis par Android 14+ pour foregroundServiceType="specialUse" -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Floating overlay bubble for Japanese language learning" />
        </service>

        <!-- Service d'accessibilité : lit le texte des vues -->
        <service
            android:name=".accessibility.LinguaAccessibilityService"
            android:exported="true"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

    </application>
</manifest>
